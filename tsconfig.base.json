{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@receipt-ocr/ai": ["packages/ai/src/index.ts"],
      "@receipt-ocr/core": ["packages/core/src/index.ts"],
      "@receipt-ocr/db": ["packages/db/src/index.ts"],
      "@receipt-ocr/storage": ["packages/storage/src/index.ts"],
      "@receipt-ocr/ui/*": ["packages/ui/src/*"]
    }
  }
}
