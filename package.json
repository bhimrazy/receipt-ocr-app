{
  "name": "receipt-ocr-app",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "eslint .",
    "typecheck": "turbo typecheck && tsc -p bench",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "check:deps": "bun scripts/check-deps.ts",
    "knip": "knip",
    "brand:assets": "bun scripts/brand-assets.ts",
    "audit": "bun audit --audit-level=high",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "docker:app": "docker compose --profile app up --build",
    "docker:dev": "docker compose --profile dev up --build",
    "docker:logs": "docker compose logs -f",
    "db:migrate": "bun run --filter @receipt-ocr/web db:migrate",
    "db:generate": "bun run --filter @receipt-ocr/web db:generate",
    "db:studio": "bun run --filter @receipt-ocr/web db:studio",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:watch": "vitest",
    "test:e2e": "bun run --filter @receipt-ocr/web test:e2e",
    "splash:ios": "bun scripts/splash-ios.ts",
    "bench:ocr": "bun bench/ocr.ts",
    "bench:fixtures": "bun bench/make-fixtures.mjs",
    "bench:encode": "bun bench/encode.mjs",
    "email:generate": "bun packages/email/scripts/generate.ts",
    "email:check": "bun packages/email/scripts/generate.ts --check",
    "email:preview": "bun scripts/email-preview.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@receipt-ocr/ai": "workspace:*",
    "@types/node": "25.9.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "knip": "6.43.0",
    "sharp": "0.35.5",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
