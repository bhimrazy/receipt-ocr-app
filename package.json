{
  "name": "receipt-ocr-app",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "docker:app": "docker compose --profile app up --build",
    "docker:dev": "docker compose --profile dev up --build",
    "docker:logs": "docker compose logs -f",
    "db:migrate": "bun run --filter @receipt-ocr/web db:migrate",
    "db:generate": "bun run --filter @receipt-ocr/web db:generate",
    "db:studio": "bun run --filter @receipt-ocr/web db:studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "prettier": "3.8.3",
    "turbo": "2.9.16",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
