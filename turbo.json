{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "!.next/cache/**"],
      "env": [
        "ADMIN_EMAILS",
        "ANTHROPIC_*",
        "AUTH_REQUIRE_EMAIL_VERIFICATION",
        "BETTER_AUTH_*",
        "DATABASE_*",
        "DIRECT_URL",
        "EMAIL_FROM",
        "GEMINI_*",
        "GIT_COMMIT_SHA",
        "GITHUB_CLIENT_*",
        "GOOGLE_*",
        "GROQ_*",
        "NEXT_OUTPUT",
        "NEXT_PUBLIC_*",
        "OCR_*",
        "OPENAI_*",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT",
        "POSTHOG_KEY",
        "RESEND_API_KEY",
        "RESEND_NEWSLETTER_SEGMENT_ID",
        "S3_*",
        "SENTRY_DSN",
        "SUPPORT_EMAIL",
        "TRUSTED_IP_HEADERS",
        "TRUSTED_PROXIES",
        "VERCEL",
        "VERCEL_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
