# syntax=docker/dockerfile:1

# Production image: Next.js standalone server on Bun. Build from the repo root:
#   docker build -f docker/Dockerfile.prod -t receipt-ocr-web .
# The `builder` stage doubles as the migration runner (see docker-compose.yml).

# Pinned by digest (multi-arch index of oven/bun:1.4.4-alpine, built 2026-10-22).
FROM oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a AS base
WORKDIR /repo

FROM base AS builder
# Manifests first so the install layer is reused until a dependency changes.
COPY package.json bun.lock bunfig.toml ./
COPY apps/web/package.json apps/web/
COPY packages/ai/package.json packages/ai/
COPY packages/bench/package.json packages/bench/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/email/package.json packages/email/
COPY packages/storage/package.json packages/storage/
COPY packages/ui/package.json packages/ui/
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile

COPY . .
# Read by next.config.ts at build: a valid DSN builds browser error reporting in (a DSN is
# public); the commit names the release. Both optional, and kept to this stage: the runtime
# image takes SENTRY_DSN from its own environment for server reporting.
#   docker build --build-arg SENTRY_DSN=... --build-arg GIT_COMMIT_SHA=$(git rev-parse HEAD) ...
ARG SENTRY_DSN=""
ARG GIT_COMMIT_SHA=""
# Opt in to the standalone bundle only for the image; Vercel builds normally.
ENV NEXT_OUTPUT=standalone \
    NEXT_TELEMETRY_DISABLED=1 \
    SENTRY_DSN=${SENTRY_DSN} \
    GIT_COMMIT_SHA=${GIT_COMMIT_SHA}
RUN bun run --filter @receipt-ocr/web build

# `output: "standalone"` emits a self-contained server plus only the
# node_modules it reaches, which keeps the runtime image small.
FROM base AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup -S -g 1001 nextjs && adduser -S -u 1001 -G nextjs nextjs

COPY --from=builder --chown=nextjs:nextjs /repo/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nextjs /repo/apps/web/.next/static ./apps/web/.next/static

USER nextjs
EXPOSE 3000
CMD ["bun", "apps/web/server.js"]
