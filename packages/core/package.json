{
  "name": "@receipt-ocr/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./plans": "./src/plans.ts",
    "./telemetry": "./src/telemetry/index.ts",
    "./telemetry/otlp": "./src/telemetry/otlp.ts",
    "./upload-limits": "./src/upload-limits.ts",
    "./group-rules": "./src/group-rules.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:int": "INTEGRATION=1 vitest run --root ../.. --no-file-parallelism packages/core/src/receipts.int.test.ts packages/core/src/admin.int.test.ts packages/core/src/admin-ops.int.test.ts packages/core/src/analytics/spend.int.test.ts packages/core/src/jobs/jobs.int.test.ts packages/core/src/groups.int.test.ts packages/core/src/rls.int.test.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.300.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@receipt-ocr/ai": "workspace:0.0.0",
    "@receipt-ocr/db": "workspace:0.0.0",
    "@receipt-ocr/storage": "workspace:0.0.0",
    "effect": "3.22.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "drizzle-orm": "0.45.4",
    "typescript": "6.0.3"
  }
}
