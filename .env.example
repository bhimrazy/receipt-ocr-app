# Root env, read by docker compose. Per-app runtime config lives in
# apps/web/.env.local (see apps/web/.env.example).
#
#   cp .env.example .env
#   bun run docker:up

# Host ports, in case something already owns these.
APP_PORT=3000
# 5433 by default: 5432 is usually taken by another local Postgres.
POSTGRES_PORT=5433
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Needed for real OCR. Everything else in the stack works without it.
GOOGLE_GENERATIVE_AI_API_KEY=
# Current stable Flash model. Swap for gemini-3.1-flash-lite to cut cost.
GEMINI_MODEL=gemini-3.7-flash
# `fixture` returns canned extractions with no network: tests, e2e and load tests.
OCR_PROVIDER=google
# Optional spend guard: receipts read per UTC day across all users.
OCR_DAILY_CAP=
# Used by `docker compose --profile app` (defaults to x-forwarded-for there).
# Required in production off Vercel: the header your reverse proxy sets to the
# client IP. Leave unset on Vercel, which uses x-forwarded-for by default.
TRUSTED_IP_HEADERS=
# Proxy IPs/CIDRs that APPEND to that header (e.g. nginx
# $proxy_add_x_forwarded_for), comma-separated: 10.0.0.5,10.1.0.0/24.
TRUSTED_PROXIES=
# Defaults to true in production. Set false only for tests with no mailer.
AUTH_REQUIRE_EMAIL_VERIFICATION=

# Only used by `docker compose --profile app`; `bun dev` reads
# apps/web/.env.local instead.
BETTER_AUTH_SECRET=
ADMIN_EMAILS=
# Optional. Without both, mail is logged with a working link instead of sent.
# Resend test recipients (no real delivery): delivered@resend.dev,
# bounced@resend.dev, complained@resend.dev, suppressed@resend.dev
RESEND_API_KEY=
EMAIL_FROM=
# Inbox that receives support-form messages (reply-to is the sender). Needed in production.
SUPPORT_EMAIL=
