# docker compose environment (the local stack: Postgres, RustFS, and optionally the app).
#
#   cp .env.example .env
#   bun run docker:up
#
# Only for compose. `bun dev` reads apps/web/.env.local instead; every app variable is
# explained in apps/web/.env.example. Compose wires DATABASE_URL, BETTER_AUTH_URL and
# the S3 settings to its own Postgres and RustFS, so they don't appear here.
# Keep account-wide tokens (Supabase, Vercel, GitHub, Anthropic) out of this file.

# --- Host ports, in case something already owns these ----------------------------------
APP_PORT=3000
# 5433 by default: 5432 is usually taken by another local Postgres.
POSTGRES_PORT=5433
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# --- The app container (`docker compose --profile app` / `--profile dev`) ----------------
# Needed for real OCR; everything else in the stack works without it.
GOOGLE_GENERATIVE_AI_API_KEY=
# First-run default model. gemini-3.5-flash-lite costs less.
GEMINI_MODEL=gemini-3.8-flash
# google (default), or fixture for canned extractions with no network.
OCR_PROVIDER=google
# At least 32 characters: openssl rand -base64 32. Compose has a local default.
BETTER_AUTH_SECRET=
# Optional rotation list, current first: 2:<new>,1:<old>.
BETTER_AUTH_SECRETS=
ADMIN_EMAILS=
# Without both, mail isn't sent. Test recipients that never deliver:
# delivered@resend.dev, bounced@resend.dev, complained@resend.dev, suppressed@resend.dev
RESEND_API_KEY=
EMAIL_FROM=
# Inbox for support-form messages.
SUPPORT_EMAIL=
# Compose defaults this to x-forwarded-for. Behind a proxy that APPENDS to the header
# (nginx $proxy_add_x_forwarded_for), list its IPs/CIDRs: 10.0.0.5,10.1.0.0/24.
TRUSTED_IP_HEADERS=
TRUSTED_PROXIES=
