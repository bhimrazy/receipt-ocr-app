{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["files", "dependencies", "unlisted", "unresolved", "binaries", "duplicates"],
  "workspaces": {
    ".": {
      "entry": ["vitest.server-only.ts", "scripts/*.{ts,mjs}"]
    },
    "apps/web": {
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/bench": {
      "entry": ["*.{ts,mjs}", "load/*.mjs"]
    },
    "packages/email": {
      "entry": ["scripts/*.ts"]
    }
  },
  "ignore": ["packages/bench/load/*.js", "apps/web/public/*.js"]
}
