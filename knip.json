{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["files", "dependencies", "unlisted", "unresolved", "binaries", "duplicates"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{ts,mjs}", "bench/*.{ts,mjs}", "bench/load/*.mjs"]
    },
    "apps/web": {
      "ignoreDependencies": ["tailwindcss"]
    }
  },
  "ignore": ["bench/load/*.js", "apps/web/public/*.js"]
}
