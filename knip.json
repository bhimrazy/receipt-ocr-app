{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["files", "dependencies", "unlisted", "unresolved", "binaries", "duplicates"],
  "workspaces": {
    ".": {
      "entry": [
        "vitest.server-only.ts",
        "scripts/*.{ts,mjs}",
        "bench/*.{ts,mjs}",
        "bench/load/*.mjs"
      ]
    },
    "apps/web": {
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/email": {
      "entry": ["scripts/*.ts"]
    }
  },
  "ignore": ["bench/load/*.js", "apps/web/public/*.js"]
}
