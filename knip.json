{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["files", "dependencies", "unlisted", "unresolved", "binaries", "duplicates"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{ts,mjs}", "bench/*.{ts,mjs}"],
      "ignoreDependencies": ["@types/react-dom"]
    },
    "apps/web": {
      "ignoreDependencies": ["tailwindcss"]
    }
  },
  "ignore": ["bench/upload.k6.js"]
}
