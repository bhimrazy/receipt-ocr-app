# --- Database (Postgres / Supabase) -----------------------------------------
# DATABASE_URL can be a Supabase pooler URL. Use the TRANSACTION pooler
# (port 6543) for the app — postgres-js runs with prepare:false, which the
# transaction pooler requires. Run drizzle-kit migrations against the SESSION
# pooler (port 5432) instead.
# Matches the docker compose default (POSTGRES_PORT=5433).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/receipt_ocr

# --- Better Auth --------------------------------------------------------------
# Generate the secret with: openssl rand -base64 32 (min 32 chars)
BETTER_AUTH_SECRET=
# Optional, for rotation: versioned secrets, current first, e.g. 2:<new>,1:<old>.
# Older versions still decrypt stored OAuth tokens. Keep BETTER_AUTH_SECRET set
# while moving to this, so tokens sealed under it stay readable. Rotating the
# current version signs everyone out. Losing every secret loses stored tokens.
BETTER_AUTH_SECRETS=
# Canonical app origin, e.g. https://receiptocr.example.com
BETTER_AUTH_URL=http://localhost:3000

# Social sign-in (optional). Each provider is enabled only when BOTH of its
# vars are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin bootstrap. Comma-separated emails auto-promoted to the "admin" role
# when they sign up (grants access to /admin). To promote an EXISTING user,
# run: UPDATE "user" SET role = 'admin' WHERE email = 'you@example.com';
ADMIN_EMAILS=

# --- Email (Resend) ----------------------------------------------------------
# Without both of these, transactional mail (password reset, email
# verification, workspace invitations) is logged to the server console with a
# working link instead of being sent.
# For testing, Resend accepts these recipient addresses without sending real
# mail: delivered@resend.dev, bounced@resend.dev, complained@resend.dev,
# suppressed@resend.dev (all but the last support +labels).
# https://resend.com/docs/knowledge-base/what-email-addresses-to-use-for-testing
RESEND_API_KEY=
EMAIL_FROM="receiptOCR <onboarding@resend.dev>"

# --- AI ------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=
# Current stable Flash model, verified against a live key. Note that
# gemini-2.5-flash now returns "no longer available to new users" — if you have
# it pinned anywhere, that is why extraction fails. gemini-3.1-flash-lite is
# cheaper and faster for clean scans.
GEMINI_MODEL=gemini-3.7-flash

# --- Storage (S3 compatible) -----------------------------------------------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=receipt-ocr
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# google (default) or fixture (canned results, no network).
OCR_PROVIDER=
# Optional: receipts read per UTC day across all users.
OCR_DAILY_CAP=
# Required in production off Vercel (the app refuses to start without it): the
# header your reverse proxy sets to the client IP, e.g. x-forwarded-for.
# Leave unset on Vercel, which uses x-forwarded-for by default.
TRUSTED_IP_HEADERS=
# Proxy IPs/CIDRs that APPEND to that header rather than overwrite it,
# comma-separated, e.g. 10.0.0.5,10.1.0.0/24. The client IP is then the
# right-most address not in this list.
TRUSTED_PROXIES=
