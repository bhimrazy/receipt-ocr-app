# App environment for apps/web.
#
#   cp apps/web/.env.example apps/web/.env.local   # read by `bun dev`
#
# Production (Vercel): set these in the project's Environment Variables, secrets as
# "Sensitive". docs/deployment.md lists which are required where.
# Marks: [required] needed in production · [build] read at `next build`, so it must be set
# before building · [off-Vercel] only needed when not on Vercel.
# Set by the platform, never here: VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_BRANCH_URL,
# VERCEL_REGION, VERCEL_GIT_COMMIT_SHA (GIT_COMMIT_SHA is the Docker image's equivalent).

# --- App URLs ------------------------------------------------------------------
# [required] The exact origin users visit. Auth refuses requests from any other host,
# and email links (verification, reset, invites) are built from it.
# Vercel previews may leave it unset: they use their own preview URL.
BETTER_AUTH_URL=http://localhost:3000
# [required][build] Same origin, for canonical URLs, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Postgres; Supabase in production) -------------------------------
# [required] The running app. On Supabase use the TRANSACTION pooler (port 6543):
# postgres-js runs with prepare:false, which that pooler requires.
# The default matches the docker compose stack (POSTGRES_PORT=5433).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/receipt_ocr
# Migrations only (`bun run db:migrate`): the Supabase SESSION pooler (port 5432).
# Falls back to DATABASE_URL. Never needed by the running app or Vercel.
DIRECT_URL=
# Optional: connections per app instance (default 5).
DATABASE_POOL_MAX=

# --- Auth (Better Auth) ----------------------------------------------------------
# [required] Signing and encryption secret, at least 32 characters:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional, for rotation: versioned secrets, current first, e.g. 2:<new>,1:<old>.
# Older versions still decrypt stored OAuth tokens; keep BETTER_AUTH_SECRET set while
# moving to this. Rotating the current version signs everyone out.
BETTER_AUTH_SECRETS=
# Comma-separated emails made platform admin (/admin) when they sign up and verify.
# To promote an existing user: UPDATE "user" SET role = 'admin' WHERE email = '...';
ADMIN_EMAILS=
# Defaults to true in production. Set false only for tests with no mailer; production
# warns, because anyone could register an address they don't own.
AUTH_REQUIRE_EMAIL_VERIFICATION=
# Social sign-in (optional). A provider turns on only when BOTH of its values are set.
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/google (or /github).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (Resend) ----------------------------------------------------------------
# [required] Without both, verification, reset and invite mail isn't sent; in local
# development the link is logged instead. EMAIL_FROM must use a domain verified in Resend.
# Test recipients that never deliver: delivered@resend.dev, bounced@resend.dev,
# complained@resend.dev, suppressed@resend.dev.
RESEND_API_KEY=
EMAIL_FROM="receiptOCR <onboarding@resend.dev>"
# [required] Inbox for support-form messages (reply-to is the sender).
SUPPORT_EMAIL=

# --- OCR (AI models) ----------------------------------------------------------------
# google (default) or fixture (canned results, no network: tests, e2e, load tests).
OCR_PROVIDER=
# [required] Gemini key. Use a paid Google project in production: free-tier content
# may be used by Google.
GOOGLE_GENERATIVE_AI_API_KEY=
# First-run default model; after that, choose models in Admin → Settings. Must be an
# id from packages/ai/src/models.ts. gemini-3.5-flash-lite is cheaper for clean scans.
GEMINI_MODEL=gemini-3.8-flash
# Optional spend guard: OCR rounds per UTC day across all users. Leave unset for no
# cap; an empty or non-integer value is an error.
OCR_DAILY_CAP=
# Optional: monthly model spend in USD; Admin → Operations projects against it.
OCR_MONTHLY_BUDGET_USD=

# --- Storage (S3 compatible: Cloudflare R2, AWS S3, RustFS) ---------------------------
# [required] R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region auto,
# and an R2 API token with Object Read & Write on this bucket only.
# Browsers only load images through short-lived signed URLs, so no CORS is needed.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=receipt-ocr
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for RustFS and other self-hosted stores (the compose stack); leave unset for R2.
S3_FORCE_PATH_STYLE=true

# --- Bot protection (Cloudflare Turnstile, optional) -----------------------------------
# Set BOTH keys or neither (the app refuses to start with one). With both, sign-up,
# sign-in, password reset, resend confirmation and the support form need a passed check.
# Keys: Cloudflare dashboard → Turnstile → add a widget for your domain, mode "Managed".
# Test keys (always pass): site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
# [build] The site key is public and baked into the client bundle.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: hostnames siteverify must report, comma-separated. Defaults to the
# BETTER_AUTH_URL host. Cloudflare's test keys report example.com.
TURNSTILE_ALLOWED_HOSTNAMES=

# --- Analytics (optional) ----------------------------------------------------------------
# [build] Google Analytics 4 measurement id (G-...). Shows the cookie banner; GA loads
# only after consent. Cookie-free page counts need nothing here (Vercel Web Analytics).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Networking (off Vercel only) ---------------------------------------------------------
# [off-Vercel] The header your reverse proxy sets to the client IP, e.g. x-forwarded-for.
# Production refuses to start without it off Vercel; leave unset on Vercel.
TRUSTED_IP_HEADERS=
# Needed when your proxy APPENDS to that header (nginx $proxy_add_x_forwarded_for)
# instead of overwriting it, or every client shares one rate-limit bucket.
# Proxy IPs/CIDRs, comma-separated, e.g. 10.0.0.5,10.1.0.0/24.
TRUSTED_PROXIES=

# --- Development ---------------------------------------------------------------------------
# [build] 1 shows the design lab pages (/landing-*, /final-*) in a production build;
# they always show in `bun dev`.
LAB_PAGES=
