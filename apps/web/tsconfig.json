{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "jsx": "preserve",
    "paths": {
      "@/*": ["./*"],
      "@receipt-ocr/ai": ["../../packages/ai/src/index.ts"],
      "@receipt-ocr/calendar": ["../../packages/calendar/src/index.ts"],
      "@receipt-ocr/core": ["../../packages/core/src/index.ts"],
      "@receipt-ocr/db": ["../../packages/db/src/index.ts"],
      "@receipt-ocr/storage": ["../../packages/storage/src/index.ts"],
      "@receipt-ocr/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
